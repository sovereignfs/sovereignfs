{
  "$schema": "https://unpkg.com/@sovereignfs/workbench@0/schema/manifest.schema.json",
  "version": 1,
  "name": "sovereignfs",
  "defaults": {
    "branch": "main",
    "install": "pnpm",
    "carry": [
      ".env"
    ]
  },
  "pods": {
    "dir": "pods",
    "portBase": 5000,
    "blockSize": 10
  },
  "killPort": {
    "defaults": [
      "3000-3999",
      "4000-4999",
      "5000-5999"
    ]
  },
  "repos": [
    {
      "id": "sovereign",
      "url": "git@github.com:sovereignfs/sovereign.git",
      "path": "sovereign",
      "type": "launcher",
      "pod": {
        "prefix": "p",
        "ports": [
          {
            "key": "RUNTIME_PORT",
            "default": 3000
          },
          {
            "key": "AUTH_PORT",
            "default": 3001
          }
        ]
      }
    },
    {
      "id": "sovereign",
      "url": "git@github.com:sovereignfs/sovereign-legacy.git",
      "path": "sovereign-legacy",
      "type": "launcher",
      "legacy": true
    },
    {
      "id": "sovereign-os",
      "url": "git@github.com:sovereignfs/sovereign-os.git",
      "path": "sovereign-os",
      "type": "os",
      "skip": true,
      "pod": {
        "prefix": "os"
      }
    },
    {
      "id": "sovereign-edge",
      "url": "git@github.com:sovereignfs/sovereign-edge.git",
      "path": "sovereign-edge",
      "type": "mobile",
      "skip": true
    },
    {
      "id": "sovereign-mobile",
      "url": "git@github.com:sovereignfs/sovereign-mobile.git",
      "path": "sovereign-mobile",
      "type": "mobile",
      "skip": true
    },
    {
      "id": "sovereign-desktop",
      "url": "git@github.com:sovereignfs/sovereign-desktop.git",
      "path": "sovereign-desktop",
      "type": "desktop",
      "skip": true
    },
    {
      "id": "sovereign-infra",
      "url": "git@github.com:sovereignfs/sovereign-infra.git",
      "path": "sovereign-infra",
      "type": "support",
      "legacy": true,
      "skip": true
    },
    {
      "id": "workbench",
      "url": "git@github.com:sovereignfs/workbench.git",
      "path": "workbench",
      "type": "tooling",
      "skip": true
    },
    {
      "id": "fjord",
      "url": "git@github.com:sovereignfs/fjord",
      "path": "fjord",
      "type": "sovereign-app"
    },
    {
      "id": "foundry",
      "url": "git@github.com:sovereignfs/foundry",
      "path": "foundry",
      "type": "sovereign-app"
    },
    {
      "id": "haven",
      "url": "git@github.com:sovereignfs/haven",
      "path": "haven",
      "type": "sovereign-app"
    },
    {
      "id": "ledger",
      "url": "git@github.com:sovereignfs/ledger",
      "path": "ledger",
      "type": "sovereign-app"
    },
    {
      "id": "loom",
      "url": "git@github.com:sovereignfs/loom",
      "path": "loom",
      "type": "sovereign-app"
    },
    {
      "id": "shopper",
      "url": "git@github.com:sovereignfs/shopper",
      "path": "shopper",
      "type": "sovereign-app"
    },
    {
      "id": "tally",
      "url": "git@github.com:sovereignfs/tally",
      "path": "tally",
      "type": "sovereign-app"
    },
    {
      "id": "tusk",
      "url": "git@github.com:sovereignfs/tusk",
      "path": "tusk",
      "type": "sovereign-app"
    },
    {
      "id": "wallet",
      "url": "git@github.com:sovereignfs/wallet",
      "path": "wallet",
      "type": "sovereign-app"
    },
    {
      "id": "waymark",
      "url": "git@github.com:sovereignfs/waymark",
      "path": "waymark",
      "type": "sovereign-app"
    }
  ]
}
